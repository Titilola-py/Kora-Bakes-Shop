# Copy this file to `.env` and fill in the values shown below.
# `.env` is git-ignored and must never be committed.
#
# Only public, publishable credentials belong here. EXPO_PUBLIC_* values are
# compiled into the app bundle, so never put the Supabase service-role key, the
# database password, the Paystack secret or the Mailgun key in this file.

# Production Kora Bakes API. Use the deployed host for physical-device testing;
# never use localhost on a phone.
EXPO_PUBLIC_API_BASE_URL=https://kora-bakes.onrender.com

# The same Supabase project the website uses, so a mobile sign-in resolves to
# the same account - and therefore the same server cart.
EXPO_PUBLIC_SUPABASE_URL=https://wkxxspiqkdnrnwahrkyl.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=